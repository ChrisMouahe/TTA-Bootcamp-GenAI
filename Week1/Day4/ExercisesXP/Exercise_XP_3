# import the Dog class

import random
from __init__ import Dog

class PetDog(Dog):
      def __init__(self, name, age, weight):
            super().__init__(name, age, weight)
            self.trained = False

      def train(self): 
            print(self.bark())
            self.trained = True

      def play(self, *args):
            dogs = [self.name] 
            for dog in args :
                  dogs.append(dog)
            print (f'{", ".join(dogs)} all play together')

      def do_a_trick(self): 
        if self.trained:
            tricks = ["does a barrel roll", "stands on his back legs", "shakes your hand", "plays dead"]
            print(f"{self.name} {random.choice(tricks)}")

# Test PetDog methods
my_dog = PetDog("Fido", 2, 10)
my_dog.train()
my_dog.play("Buddy", "Max")
my_dog.do_a_trick()






